# MAVSDK
# MAVSDK_SYSTEM_ADDRESS=udp://:14540
#MAVSDK_SYSTEM_ADDRESS=serial:///dev/ttyUSB0:57600
MAVSDK_SYSTEM_ADDRESS=serial:///dev/ttyAMA0:57600
# Camera
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# YOLO input resolution (lower = faster inference)
YOLO_WIDTH=320
YOLO_HEIGHT=320
YOLO_CONF=0.7

# YOLO model path (ONNX preferred)
YOLO_MODEL_PATH=/home/pi/terbangsemhas/yolov8n320.onnx
# YOLO_MODEL_PATH=/home/eeja/Documents/terbangnew5/yolov8n_int8.tflite

# UDP H264 stream output
UDP_STREAM_HOST=127.0.0.1
UDP_STREAM_PORT=5600

# Flask
PORT=3000
SECRET_KEY=drone-secret
CORS_ORIGINS=http://localhost:5173,http://192.168.4.1:5173,http://192.168.4.1:3000,http://100.81.175.103:5173,http://100.81.175.103:3000,http://100.92.182.117:5173,http://100.92.182.117:3000,http://192.168.100.71:3000,http://192.168.100.71:5173,http://192.168.100.176:5173.http://192.168.100.176:3000,http://172.20.10.14:3000,http://172.20.10.14:5173
